# Copia este archivo a .env (está en .gitignore) y completa los valores antes de `docker compose up`.

# Contraseña de PostgreSQL (la usan el contenedor de la base y la app).
DATABASE_PASSWORD=

# Secreto para firmar los JWT: al menos 32 caracteres aleatorios.
# Por ejemplo: openssl rand -base64 48
JWT_SECRET=

# Atributo Secure de la cookie de sesión: false para http://localhost, true detrás de HTTPS.
AUTH_COOKIE_SECURE=false

# Opcional: credenciales de AWS para las funciones de IA (Amazon Bedrock).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
